# ─── Workers Service ─────────────────────────────────────
NODE_ENV=development

# ─── Database ────────────────────────────────────────────
# Production and test modes require an explicit URI or MONGODB_URI_FILE.
# Atlas-only: copy a real URI into gitignored workers/.env (never commit credentials)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Cache ───────────────────────────────────────────────
# Production and test modes require an explicit URL or REDIS_URL_FILE.
REDIS_URL=redis://redis:6379

# ─── Worker Configuration ────────────────────────────────
WORKER_CONCURRENCY=1

# ─── Notification Delivery ───────────────────────────────
# Transport: "rest" (no push — poll-only, default) or "socket" (real-time
# socket.io push so browser toasts fire). Docker Compose sets "socket".
NOTIFICATION_TRANSPORT=rest
# API's socket.io URL as seen from the worker (use the compose service name
# inside Docker, e.g. http://api:5000).
NOTIFICATION_SOCKET_URL=http://localhost:5000
# Shared machine token — must match the API's NOTIFICATION_SOCKET_SERVICE_TOKEN.
# Required in production/test when NOTIFICATION_TRANSPORT=socket.
NOTIFICATION_SOCKET_SERVICE_TOKEN=

# ─── User Invitation Emails ──────────────────────────────
# Frontend base URL used to build /set-password-from-invite links.
APP_FRONTEND_URL=http://localhost:3000
# Secret shared with the API service (signs bulk-import invitation tokens).
# Required in production/test — must match the API's EMAIL_VERIFICATION_JWT_SECRET.
EMAIL_VERIFICATION_JWT_SECRET=
EMAIL_VERIFICATION_JWT_EXPIRES_IN=24h

# ─── File Storage ────────────────────────────────────────
UPLOAD_DIR=../api/uploads
STORAGE_PROVIDER=local
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── OCR Provider ────────────────────────────────────────
# Provider selection: "fake" (testing), "tesseract" (local), "paddle" (PaddleOCR service)
OCR_PROVIDER=fake
# Fallback provider used when primary fails after all retries
OCR_FALLBACK_PROVIDER=fake
# Per-page OCR timeout in milliseconds
OCR_TIMEOUT=30000
# Max retry attempts per provider before falling back
OCR_MAX_RETRIES=3
# Delay between retries in milliseconds (multiplied by attempt number)
OCR_RETRY_DELAY_MS=1000
# Confidence thresholds for quality gating (0-1 scale)
OCR_CONFIDENCE_THRESHOLD=0.7
OCR_CRITICAL_CONFIDENCE_THRESHOLD=0.4
# Maximum pages per OCR job
OCR_MAX_PAGES=2000
# Maximum pages per auto-OCR run (ingest-triggered). Supports scanned books
# up to 2000 pages.
AUTO_OCR_MAX_PAGES=2000
# How many pages are OCR'd in parallel inside one job. Tesseract is CPU-bound,
# so the default derives from the number of cores (cpus - 1, capped at 16).
OCR_CONCURRENCY=
# Number of PDF.js documents kept open for parallel page rendering (default 2).
# Raise only if rendering becomes the bottleneck; each document holds a copy of
# the file buffer in memory.
OCR_RENDER_CONCURRENCY=2
# OCR service URL (only needed when OCR_PROVIDER=ocr)
OCR_SERVICE_URL=http://localhost:8501

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=info

# ─── AI Provider ──────────────────────────────────────────
# Provider selection: "fake" (testing), "openai", "groq", "student-bedrock"
AI_PROVIDER=fake

# ─── Groq (Chat/LLM) + Jina AI (Embeddings) ──────────────
# Required when AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIMENSIONS=1024

# ─── OpenAI Embedding ────────────────────────────────────
# Required when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ─── Student Bedrock Gateway ─────────────────────────────
# Required when AI_PROVIDER=student-bedrock
SBG_API_KEY=
SBG_BASE_URL=https://apiaccess.iti.net.eg
BEDROCK_TIMEOUT_MS=30000
BEDROCK_MAX_RETRIES=3
BEDROCK_RETRY_DELAY_MS=1000
BEDROCK_CHAT_MODELS=anthropic.claude-opus-4-7,anthropic.claude-sonnet-4-6,deepseek.v3.2,openai.gpt-oss-120b
BEDROCK_FAST_CHAT_MODELS=anthropic.claude-sonnet-4-6,deepseek.v3.2
BEDROCK_EMBEDDING_MODELS=amazon.titan-embed-text-v2:0,us.cohere.embed-v4:0
BEDROCK_IMAGE_MODEL=amazon.nova-canvas-v1:0
BEDROCK_AUDIO_MODEL=amazon.nova-sonic-v1:0
