# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────
# Atlas-only: copy a real URI into gitignored api/.env (never commit credentials)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_MAX_RETRIES=5
MONGODB_RETRY_DELAY_MS=1000
MONGODB_RETRY_BACKOFF_FACTOR=2
MONGODB_RETRY_MAX_DELAY_MS=10000

# ─── Cache ───────────────────────────────────────────────
# Local dev (docker-compose): redis://redis:6379
# Production (Railway): set REDIS_URL in Railway's dashboard to your Upstash rediss:// URL
REDIS_URL=redis://redis:6379

# ─── URLs / Auth ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
APP_FRONTEND_URL=http://localhost:3000
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# One-time platform administrator bootstrap. Enable temporarily, then disable and remove the key.
ENABLE_SUPER_ADMIN_BOOTSTRAP=false
SUPER_ADMIN_BOOTSTRAP_KEY=

# ─── Email Verification ─────────────────────────────────
EMAIL_VERIFICATION_JWT_SECRET=
EMAIL_VERIFICATION_JWT_EXPIRES_IN=24h
PASSWORD_RESET_JWT_SECRET=
PASSWORD_RESET_JWT_EXPIRES_IN=15m

# ─── Email Sending ───────────────────────────────────────
SEND_EMAILS=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=
SMTP_FROM="DocuMind AI <no-reply@example.com>"

# ─── File Uploads / Storage ───────────────────────────────
UPLOAD_DIR=./uploads
STORAGE_PROVIDER=local
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_FILE_SIZE_BYTES=52428800
ALLOWED_MIME_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword

# ─── Chat Vision (Image Understanding) ────────────────────
# Max size of an uploaded chat image in bytes (10 MB default)
VISION_MAX_FILE_SIZE_BYTES=10485760
# Allowed image MIME types for chat vision uploads
VISION_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ─── Payment Provider ───────────────────────────────────
# Set to "stripe" for production, "fake" for development/test
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# URLs Stripe redirects to after checkout (must be absolute URLs)
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:3000/dashboard/settings/billing
# Required to enable the restricted Phase 2 "general" portal flow in Stripe.
# Leave empty to fail safe and expose only payment_method_update.
STRIPE_BILLING_PORTAL_GENERAL_CONFIGURATION_ID=
BILLING_PORTAL_ALLOWED_ORIGIN=http://localhost:3000
BILLING_PAST_DUE_GRACE_DAYS=7
BILLING_GOODWILL_REFUND_CAP_MINOR=0

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=false

SEED_SUPER_ADMIN_ENABLED=false
SEED_PLATFORM_TENANT_NAME=DocuMind AI
SEED_PLATFORM_TENANT_SLUG=documind-ai
SEED_SUPER_ADMIN_NAME=DocuMind Platform Admin
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# ─── OCR Provider ────────────────────────────────────────
# Provider selection: "fake" (testing), "tesseract" (local), "paddle" (PaddleOCR service)
OCR_PROVIDER=fake
# Fallback provider used when primary fails after all retries
OCR_FALLBACK_PROVIDER=fake
# Per-page OCR timeout in milliseconds
OCR_TIMEOUT=30000
# Max retry attempts per provider before falling back
OCR_MAX_RETRIES=3
# Delay between retries in milliseconds (multiplied by attempt number)
OCR_RETRY_DELAY_MS=1000
# Confidence thresholds for quality gating (0-1 scale)
OCR_CONFIDENCE_THRESHOLD=0.7
OCR_CRITICAL_CONFIDENCE_THRESHOLD=0.4
# Maximum pages per OCR job
OCR_MAX_PAGES=500
# Maximum file size for OCR input in bytes (50 MB default)
OCR_MAX_FILE_SIZE_BYTES=52428800
# OCR service URL (only needed when OCR_PROVIDER=ocr)
OCR_SERVICE_URL=http://localhost:8501

# ─── AI Provider ──────────────────────────────────────────
# Provider selection: "fake" (testing), "openai", "groq", "student-bedrock"
AI_PROVIDER=fake

# ─── Groq (Chat/LLM) + Jina AI (Embeddings) ──────────────
# Required when AI_PROVIDER=groq
# Get Groq key at: https://console.groq.com
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Vision model used by the chat image analysis feature
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Get Jina key at: https://jina.ai/api-dashboard/key-manager (10M free tokens)
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIMENSIONS=1024

# ─── OpenAI Embedding ────────────────────────────────────
# Required when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ─── Student Bedrock Gateway ─────────────────────────────
# Required when AI_PROVIDER=student-bedrock
SBG_API_KEY=
SBG_BASE_URL=https://apiaccess.iti.net.eg
BEDROCK_TIMEOUT_MS=30000
BEDROCK_MAX_RETRIES=3
BEDROCK_RETRY_DELAY_MS=1000
BEDROCK_CHAT_MODELS=anthropic.claude-opus-4-7,anthropic.claude-sonnet-4-6,deepseek.v3.2,openai.gpt-oss-120b
BEDROCK_FAST_CHAT_MODELS=anthropic.claude-sonnet-4-6,deepseek.v3.2
BEDROCK_EMBEDDING_MODELS=amazon.titan-embed-text-v2:0,us.cohere.embed-v4:0
BEDROCK_IMAGE_MODEL=amazon.nova-canvas-v1:0
BEDROCK_AUDIO_MODEL=amazon.nova-sonic-v1:0
